# Conexão com o banco de dados (PostgreSQL local via Docker, porta 5433)
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5433/NOME_DO_BANCO?schema=public

# JWT Segredos: lista de chaves separadas por vírgula.
# A primeira chave assina os tokens; todas as chaves da lista validam tokens (permite rotação segura).
JWT_SECRETS=SECRETO_1,SECRETO_2

# Expiração do access token JWT
JWT_ACCESS_EXPIRES_IN=15m

# URL da aplicação
APP_URL=http://localhost:3000